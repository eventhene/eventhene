# ==============================================================
# EventHene - environment variables
# Copy this file to .env.local and fill in real values
# ==============================================================

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=EventHene

# Database (Supabase Postgres)
# Get from: Supabase Dashboard -> Project Settings -> Database -> Connection String
DATABASE_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# Clerk Authentication
# Get from: clerk.com -> Your App -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# Supabase Storage (for flyers + ticket PDFs)
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_FLYERS=flyers
SUPABASE_BUCKET_TICKETS=tickets

# Paystack (primary payment processor for Ghana/Nigeria)
# Get from: paystack.com -> Settings -> API Keys
PAYSTACK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_...

# Stripe (fallback for diaspora/USD)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Email - Resend
# Get from: resend.com -> API Keys
RESEND_API_KEY=re_...
EMAIL_FROM="EventHene <tickets@eventhene.com>"
EMAIL_REPLY_TO=support@eventhene.com

# SMS - Twilio (optional, for paid SMS reminders)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# QR ticket signing secret - GENERATE: openssl rand -base64 48
QR_SIGNING_SECRET=replace-with-long-random-string-at-least-32-chars

# Background jobs - Upstash QStash
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Rate limiting - Upstash Redis (optional but recommended)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Admin
ADMIN_NOTIFY_EMAIL=ops@eventhene.com
