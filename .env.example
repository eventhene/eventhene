# ==============================================================
# EventHene - environment variables
# Copy this file to .env.local and fill in real values
# ==============================================================

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=EventHene

# Database (Supabase Postgres)
DATABASE_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# Auth secret - sign JWT session cookies.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET=replace-with-long-random-string-at-least-32-chars

# QR ticket signing secret (can be the same as AUTH_SECRET or different)
QR_SIGNING_SECRET=replace-with-long-random-string-at-least-32-chars

# Admin bootstrap - comma-separated emails. These accounts become SUPER_ADMIN automatically.
BOOTSTRAP_ADMIN_EMAILS=eventhene@gmail.com

# Supabase Storage (for flyers + ticket PDFs)
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_FLYERS=flyers
SUPABASE_BUCKET_TICKETS=tickets

# Hubtel SMS (Ghana)
# Get from: unity.hubtel.com -> Developer -> API Keys
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
# Platform default Sender ID used when an organizer has no approved custom one.
# Hubtel caps this at 11 alphanumeric chars.
HUBTEL_SENDER_ID=EventHene

# Email - Resend (optional for MVP)
RESEND_API_KEY=
EMAIL_FROM="EventHene <tickets@eventhene.com>"
EMAIL_REPLY_TO=support@eventhene.com

# Email fallback (any SMTP, e.g. Gmail app password, Brevo, Zoho). Used automatically
# when Resend fails or hits its limit. EMAIL_PROVIDER: auto (default) | resend | smtp
EMAIL_PROVIDER=auto
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Paystack (optional, enable when ready for paid events)
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Admin notifications
ADMIN_NOTIFY_EMAIL=ops@eventhene.com
